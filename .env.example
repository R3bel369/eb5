# ============================================================
# SHOORA EB-5 — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your credentials.
# Never commit .env to source control.
# Variables prefixed with VITE_ are exposed to the browser.
# All others are server-side only (Supabase Edge Functions / backend).
# ============================================================

# ── SUPABASE (Public – safe for browser) ─────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── SUPABASE (Server-side only – NEVER prefix with VITE_) ────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── AI PROVIDER ───────────────────────────────────────────────
# OpenAI, Gemini, Anthropic, etc. — kept server-side only.
AI_PROVIDER=openai
AI_PROVIDER_API_KEY=sk-your-api-key-here
AI_MODEL=gpt-4o

# ── SMS PROVIDER (Twilio) ─────────────────────────────────────
# Required for phone OTP delivery via Supabase Auth.
# Configure these in Supabase Dashboard → Auth → Providers → Phone.
SMS_PROVIDER_ACCOUNT_ID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMS_PROVIDER_AUTH_TOKEN=your-twilio-auth-token
SMS_PROVIDER_FROM_NUMBER=+1xxxxxxxxxx

# ── MICROSOFT GRAPH API (Excel Integration) ───────────────────
# Register an app in Microsoft Entra ID (Azure AD).
# Grant: Files.ReadWrite or Sites.ReadWrite.All (least-privilege).
# For delegated flow use a client secret + admin consent.
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
# OneDrive item ID of Shoora_EB5_Leads.xlsx
MICROSOFT_DRIVE_ID=your-drive-id
MICROSOFT_WORKBOOK_ITEM_ID=your-workbook-item-id

# ── GOOGLE SHEETS API ─────────────────────────────────────────
# Option A: OAuth 2.0 (configure below)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Option B: Service Account (JSON string — keep server-side only)
# GOOGLE_SERVICE_ACCOUNT_CREDENTIALS={"type":"service_account",...}
# Spreadsheet ID (from the Google Sheets URL)
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id

# ── PUBLIC APP ────────────────────────────────────────────────
# Used for auth redirects and CORS.
PUBLIC_APP_URL=http://localhost:5173
